{
  "name": "politiks",
  "version": "0.1.0",
  "private": true,
  "description": "Browser verification for the Politiks parliamentary insight application.",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:visual": "playwright test --grep @visual",
    "playwright:install": "playwright install chromium",
    "test:php": "php tests/php/run.php",
    "test:auth-db": "php tests/php/mariadb_auth_integration.php --env=.env.test",
    "verify": "npm run test:php && npm run test:auth-db && npm test"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "bootstrap": "5.3.8",
    "bootstrap-icons": "1.13.1"
  },
  "engines": {
    "node": ">=22"
  }
}
