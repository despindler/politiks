{
  "name": "politiks",
  "version": "0.1.0",
  "private": true,
  "description": "Browser verification for the Politiks parliamentary insight application.",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:visual": "playwright test --grep @visual",
    "playwright:install": "playwright install chromium",
    "test:php": "php tests/php/run.php",
    "test:auth-db": "php tests/php/mariadb_auth_integration.php --env=.env.test",
    "test:insight-db": "php tests/php/mariadb_insight_integration.php",
    "test:wizard-db": "php tests/php/mariadb_wizard_integration.php",
    "test:context-db": "php tests/php/mariadb_campaign_context_integration.php",
    "test:ai-db": "php tests/php/mariadb_ai_foundation_integration.php --env=.env.test",
    "test:deploy": "php scripts/audit_deployment.php",
    "verify": "npm run test:php && npm run test:auth-db && npm run test:insight-db && npm run test:wizard-db && npm run test:context-db && npm run test:ai-db && npm run test:deploy && npm test",
    "verify:clean": "php scripts/verify_mvp.php --env=.env.test --reset-test-database"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "bootstrap": "5.3.8",
    "bootstrap-icons": "1.13.1"
  },
  "engines": {
    "node": ">=22"
  }
}
