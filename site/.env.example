# Copy to site/.env on the host. Never commit the populated file.
APP_ENV=production
APP_URL=https://politiks.example
APP_TIMEZONE=Europe/Zurich
APP_SECRET=replace-with-at-least-32-random-characters
APP_SESSION_NAME=politiks_session

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=politiks
DB_USER=politiks_app
DB_PASSWORD=replace-with-the-database-password
DB_CHARSET=utf8mb4

GOOGLE_CLIENT_ID=replace-with-the-web-client-id.apps.googleusercontent.com
GOOGLE_JWKS_URL=https://www.googleapis.com/oauth2/v3/certs

UPLOAD_MAX_BYTES=5242880

# Optional AI-assisted vote filtering. Enable only after configuring quotas and privacy notice.
AI_FILTER_ENABLED=0
OPENAI_API_KEY=
OPENAI_RESPONSES_URL=https://api.openai.com/v1/responses
OPENAI_MODEL=gpt-5.6-luna
AI_FILTER_TIMEOUT_SECONDS=30
AI_FILTER_MAX_OUTPUT_TOKENS=4096
AI_FILTER_CANDIDATE_LIMIT=300
AI_FILTER_CHUNK_SIZE=75
AI_FILTER_CACHE_TTL_SECONDS=3600
AI_FILTER_HOURLY_LIMIT=10

TEST_BASE_URL=https://politiks.example
