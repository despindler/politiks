# Copy this file to .env.test for local automated tests and fill in test-only values.
# Production deployment uses site/.env with the same variable names.

APP_ENV=development
APP_URL=http://127.0.0.1:8080
APP_TIMEZONE=Europe/Zurich
APP_SECRET=replace-with-a-long-random-value
APP_SESSION_NAME=politiks_session

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=politiks_test
DB_USER=politiks_test
DB_PASSWORD=
DB_CHARSET=utf8mb4

GOOGLE_CLIENT_ID=
GOOGLE_JWKS_URL=https://www.googleapis.com/oauth2/v3/certs

UPLOAD_MAX_BYTES=5242880

# Optional AI-assisted vote filtering. Disabled means no OpenAI request is made.
AI_FILTER_ENABLED=0
OPENAI_API_KEY=
OPENAI_RESPONSES_URL=https://api.openai.com/v1/responses
OPENAI_MODEL=gpt-5.6-luna
AI_FILTER_TIMEOUT_SECONDS=30
AI_FILTER_MAX_OUTPUT_TOKENS=4096
AI_FILTER_CANDIDATE_LIMIT=300
AI_FILTER_CHUNK_SIZE=75
AI_FILTER_CACHE_TTL_SECONDS=3600
AI_FILTER_HOURLY_LIMIT=10

TEST_BASE_URL=http://127.0.0.1:8080
